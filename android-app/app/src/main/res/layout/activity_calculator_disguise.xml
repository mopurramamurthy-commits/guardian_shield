<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E293B"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Display Screen of Disguised Calculator -->
    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0F172A"
        android:gravity="bottom|end"
        android:padding="24dp"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <!-- Calculator Keypad Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5">

        <Button android:id="@+id/btnC" android:text="C" style="@style/Widget.AppCompat.Button.Colored" android:backgroundTint="#EF4444" android:layout_margin="4dp" />
        <Button android:id="@+id/btnBracket" android:text="()" style="@style/Widget.AppCompat.Button.Colored" android:backgroundTint="#334155" android:layout_margin="4dp" />
        <Button android:id="@+id/btnPercent" android:text="%" style="@style/Widget.AppCompat.Button.Colored" android:backgroundTint="#334155" android:layout_margin="4dp" />
        <Button android:id="@+id/btnDivide" android:text="÷" style="@style/Widget.AppCompat.Button.Colored" android:backgroundTint="#0284C7" android:layout_margin="4dp" />

        <Button android:id="@+id/btn7" android:text="7" style="@style/Widget.AppCompat.Button.Colored" android:backgroundTint="#475569" android:layout_margin="4dp" />
        <Button android:id="@+id/btn8" android:text="8" style="@style/Widget.AppCompat.Button.Colored" android:backgroundTint="#475569" android:layout_margin="4dp" />
        <Button android:id="@+id/btn9" android:text="9" style="@style/Widget.AppCompat.Button.Colored" android:backgroundTint="#475569" android:layout_margin="4dp" />
        <Button android:id="@+id/btnMultiply" android:text="×" style="@style/Widget.AppCompat.Button.Colored" android:backgroundTint="#0284C7" android:layout_margin="4dp" />

        <Button android:id="@+id/btn4" android:text="4" style="@style/Widget.AppCompat.Button.Colored" android:backgroundTint="#475569" android:layout_margin="4dp" />
        <Button android:id="@+id/btn5" android:text="5" style="@style/Widget.AppCompat.Button.Colored" android:backgroundTint="#475569" android:layout_margin="4dp" />
        <Button android:id="@+id/btn6" android:text="6" style="@style/Widget.AppCompat.Button.Colored" android:backgroundTint="#475569" android:layout_margin="4dp" />
        <Button android:id="@+id/btnMinus" android:text="-" style="@style/Widget.AppCompat.Button.Colored" android:backgroundTint="#0284C7" android:layout_margin="4dp" />

        <Button android:id="@+id/btn1" android:text="1" style="@style/Widget.AppCompat.Button.Colored" android:backgroundTint="#475569" android:layout_margin="4dp" />
        <Button android:id="@+id/btn2" android:text="2" style="@style/Widget.AppCompat.Button.Colored" android:backgroundTint="#475569" android:layout_margin="4dp" />
        <Button android:id="@+id/btn3" android:text="3" style="@style/Widget.AppCompat.Button.Colored" android:backgroundTint="#475569" android:layout_margin="4dp" />
        <Button android:id="@+id/btnPlus" android:text="+" style="@style/Widget.AppCompat.Button.Colored" android:backgroundTint="#0284C7" android:layout_margin="4dp" />

        <Button android:id="@+id/btn0" android:text="0" style="@style/Widget.AppCompat.Button.Colored" android:backgroundTint="#475569" android:layout_columnSpan="2" android:layout_gravity="fill" android:layout_margin="4dp" />
        <Button android:id="@+id/btnDot" android:text="." style="@style/Widget.AppCompat.Button.Colored" android:backgroundTint="#475569" android:layout_margin="4dp" />
        <Button android:id="@+id/btnEquals" android:text="=" style="@style/Widget.AppCompat.Button.Colored" android:backgroundTint="#10B981" android:layout_margin="4dp" />

    </GridLayout>

</LinearLayout>
